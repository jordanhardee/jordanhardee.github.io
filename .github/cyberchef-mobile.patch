+
+    #rec-list .ingredients { min-width: 0; }
+    #rec-list .ingredients > * { max-width: 100%; }
+    #rec-list .arg.form-control { font-size: 16px; }
+    #rec-list .recip-icons {
+        position: static;
+        display: flex;
+        justify-content: flex-end;
+        align-items: center;
+        height: auto;
+    }
+    #rec-list .recip-icons i {
+        float: none;
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        width: 44px;
+        height: 44px;
+        margin: 0;
+    }
+
+    #controls {
+        position: relative;
+        flex: 0 0 auto;
+        width: 100%;
+        padding: 8px;
+    }
+    #controls-content {
+        display: flex;
+        flex-wrap: wrap;
+        justify-content: center;
+        gap: 6px;
+        transform: none !important;
+        width: 100%;
+    }
+    #controls .btn { min-height: 44px; }
+    #controls #bake { flex: 1 1 120px; }
+    #auto-bake-label { width: 78px; }
+
+    .modal-dialog { max-width: calc(100vw - 16px); margin: 8px auto; }
+    .modal-body { max-height: calc(100dvh - 150px); overflow-y: auto; }
+    .modal-footer { flex-wrap: wrap; }
+    .modal button,
+    .modal .btn { min-height: 44px; }
+
+    body.mobile-editing #mobile-nav { display: none; }
+    body.mobile-editing #workspace-wrapper { bottom: 0; }
+
+    #mobile-header button:focus-visible,
+    #mobile-nav button:focus-visible,
+    #mobile-add-operation:focus-visible,
+    .mobile-recipe-actions button:focus-visible {
+        outline: 3px solid var(--banner-url-colour);
+        outline-offset: 2px;
+    }
+}
+
+@media (max-width: 370px) {
+    .mobile-brand-label { display: none; }
+    .mobile-brand { font-size: 16px; }
+    .mobile-brand img { width: 27px; height: 27px; }
+    #mobile-header { padding: 0 8px; }
+    #mobile-nav button { font-size: 10px; }
+}
