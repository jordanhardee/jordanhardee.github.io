diff --git a/src/web/stylesheets/layout/_mobile.css b/src/web/stylesheets/layout/_mobile.css
new file mode 100644
index 0000000..c942c8d
--- /dev/null
+++ b/src/web/stylesheets/layout/_mobile.css
@@ -0,0 +1,420 @@
+/**
+ * Responsive workspace and touch controls. The desktop split-pane layout is
+ * deliberately unchanged; no duplicate editors or processing state are made.
+ *
+ * @license Apache-2.0
+ */
+
+#mobile-header,
+#mobile-nav,
+#mobile-add-operation,
+.mobile-recipe-actions {
+    display: none;
+}
+
+@media (max-width: 1023px) {
+    :root {
+        --title-height: 56px;
+        --mobile-header-height: 62px;
+        --mobile-nav-height: calc(68px + env(safe-area-inset-bottom, 0px));
+    }
+
+    html,
+    body {
+        width: 100%;
+        height: 100%;
+        overflow: hidden;
+    }
+
+    #content-wrapper {
+        position: fixed;
+        inset: 0;
+        height: 100vh;
+        height: 100dvh;
+        min-width: 0;
+        overflow: hidden;
+    }
+
+    #banner { display: none; }
+
+    #mobile-header {
+        position: absolute;
+        z-index: 15;
+        top: 0;
+        left: 0;
+        right: 0;
+        height: var(--mobile-header-height);
+        display: flex;
+        align-items: center;
+        justify-content: space-between;
+        gap: 8px;
+        padding: 0 12px;
+        background: var(--title-background-colour);
+        border-bottom: 1px solid var(--primary-border-colour);
+    }
+
+    .mobile-brand,
+    .mobile-header-actions {
+        display: flex;
+        align-items: center;
+        gap: 8px;
+        min-width: 0;
+    }
+
+    .mobile-brand {
+        font-size: 18px;
+        font-weight: 750;
+        color: var(--title-colour);
+        white-space: nowrap;
+    }
+
+    .mobile-brand img {
+        width: 32px;
+        height: 32px;
+        object-fit: contain;
+    }
+
+    .mobile-brand-label {
+        padding: 3px 5px;
+        font-size: 9px;
+        font-weight: 750;
+        letter-spacing: .07em;
+        color: var(--banner-url-colour);
+        background: var(--secondary-background-colour);
+        border: 1px solid var(--primary-border-colour);
+        border-radius: 5px;
+    }
+
+    .mobile-primary-action,
+    .mobile-icon-button,
+    #mobile-add-operation,
+    .mobile-recipe-actions button {
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        gap: 3px;
+        min-width: 44px;
+        min-height: 44px;
+        padding: 7px 9px;
+        border-radius: 10px;
+        border: 1px solid var(--primary-border-colour);
+        color: var(--primary-font-colour);
+        background: var(--primary-background-colour);
+        cursor: pointer;
+        touch-action: manipulation;
+    }
+
+    .mobile-primary-action {
+        background: var(--btn-success-bg-colour);
+        color: var(--btn-success-font-colour);
+        border-color: var(--btn-success-border-colour);
+        font-weight: 700;
+    }
+
+    .mobile-primary-action .material-icons { font-size: 21px; }
+    .mobile-menu-wrapper { position: relative; }
+
+    #mobile-menu {
+        position: absolute;
+        top: calc(100% + 8px);
+        right: 0;
+        width: 190px;
+        padding: 6px;
+        border: 1px solid var(--primary-border-colour);
+        border-radius: 12px;
+        box-shadow: 0 12px 28px #0003;
+        background: var(--primary-background-colour);
+        z-index: 50;
+    }
+
+    #mobile-menu[hidden] { display: none; }
+    #mobile-menu button {
+        width: 100%;
+        min-height: 48px;
+        border: 0;
+        border-radius: 8px;
+        background: transparent;
+        color: var(--primary-font-colour);
+        display: flex;
+        align-items: center;
+        gap: 10px;
+        text-align: left;
+        padding: 8px 12px;
+    }
+    #mobile-menu button:focus-visible,
+    #mobile-menu button:hover {
+        background: var(--secondary-background-colour);
+    }
+
